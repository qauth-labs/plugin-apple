{
  // Type-checks everything: the plugin, its tests and the end-to-end suite.
  // The published build is tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["src", "test", "e2e", "*.ts"],
  // The QAuth checkout e2e/qauth-images.sh builds the images from, and the
  // end-to-end suite's generated files.
  "exclude": ["e2e/.work", "e2e/.work-qauth"]
}
